# Optional authentication fallback for MCP requests
# Header credentials take precedence when present.
#SOLACE_CLOUD_TOKEN=your-solace-cloud-token

# Optional
# HTTP port for the MCP server (default: 3070)
#PORT=3070

# Runtime environment: production | development | test (default: development)
#NODE_ENV=development

# Logger level: silent | debug | info | warn | error | crit (default: info)
#LOG_LEVEL=info

# Enable mutation tools (default: false)
ALLOW_CREATE=false
ALLOW_UPDATE=false
ALLOW_DELETE=false
